{
	auto_https off
	http_port 8080
	admin localhost:2019
}

# Optional machine-local overlays (e.g. reverse_proxy for other Hosts that
# historically used :8080). Empty-file-safe: install-platform.sh always
# drops a comment-only placeholder in this directory.
import /etc/caddy/Caddyfile.d/*.caddy

# Single public hostname. New apps are URL paths — no Cloudflare change.
http://dash.streblainnovations.com:8080 {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer-when-downgrade
		X-Frame-Options SAMEORIGIN
	}

	@hidden {
		path /.git /.git/* /.env /.env.* /deploy.log
		path_regexp hidden (?i)^/.*/(\.git|\.env)(/|$)
	}
	respond @hidden 404

	# /races → /races/ so relative assets (images/...) resolve under the app path
	@bareApp path_regexp bare ^/([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)$
	redir @bareApp {http.request.uri.path}/ 308

	# /<slug>/* → /var/www/apps/<slug>/  (handle_path: strip /<slug> prefix)
	# Slug regexp excludes reserved _index / _logs (leading underscore).
	@app path_regexp app ^/([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)(/.*)?$
	handle @app {
		@published file /var/www/apps/{re.app.1}/index.html
		handle @published {
			uri strip_prefix /{re.app.1}
			root * /var/www/apps/{re.app.1}
			header X-App-Slug {re.app.1}
			try_files {path} {path}/ /index.html
			file_server {
				hide .git .gitignore .env
			}
		}
		handle {
			respond "No dashboard published at this path." 404
		}
	}

	# Portal at /
	handle {
		root * /var/www/apps/_index
		file_server {
			hide .git .gitignore .env
		}
	}
}

# Old subdomain → path URL
http://races.streblainnovations.com:8080 {
	redir https://dash.streblainnovations.com/races{uri} 301
}

# Unmatched Host on :8080 (LAN probes without the public Host header)
:8080 {
	respond "Grok Dashboards origin on :8080. Send Host dash.streblainnovations.com (portal /<slug>/ for apps)" 200
}
